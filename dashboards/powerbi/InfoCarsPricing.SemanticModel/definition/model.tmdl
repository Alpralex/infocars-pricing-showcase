model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","dim_date","dim_version","dim_state","fct_listings","mart_market_by_version","mart_data_quality"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table dim_date
ref table dim_version
ref table dim_state
ref table fct_listings
ref table mart_market_by_version
ref table mart_data_quality
ref table 'Price Cut'

ref cultureInfo en-US

