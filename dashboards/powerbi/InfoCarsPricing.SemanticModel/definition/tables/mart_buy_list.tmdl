table mart_buy_list
	lineageTag: 6357d1f7-4bd3-5f5a-9346-d63b9d75e1de

	/// Private-seller ads still online at or below the median of comparable ads.
	measure 'Buy Candidates' =
			COUNTROWS ( mart_buy_list )
		formatString: #,0
		displayFolder: Buy list
		lineageTag: 376f79da-179f-558a-ac5c-630022428880


	/// Candidates asked 8% or more under the comparable median: a buy at the asking price.
	measure 'Buy Now Ads' =
			CALCULATE ( COUNTROWS ( mart_buy_list ), mart_buy_list[buy_class] = "Buy now" )
		formatString: #,0
		displayFolder: Buy list
		lineageTag: d0ca0683-b2ee-533b-a47a-3c0ce5b0173c


	/// Candidates 3% to 8% under the median: the margin is there once the seller moves to the target offer.
	measure 'Negotiate Ads' =
			CALCULATE ( COUNTROWS ( mart_buy_list ), mart_buy_list[buy_class] = "Negotiate" )
		formatString: #,0
		displayFolder: Buy list
		lineageTag: 1d3415c7-1233-5338-b90b-ac825c1e254f


	/// Expected margin on the Buy now ads bought at the asking price: comparable median less asking price less 2% preparation.
	measure 'Margin at Asking Price' =
			CALCULATE ( SUM ( mart_buy_list[expected_margin_brl] ), mart_buy_list[buy_class] = "Buy now" )
		formatString: \R\$ #,0
		displayFolder: Buy list
		lineageTag: 6d5da01f-0354-594d-a661-34f0c836be65


	/// Expected margin on the Buy now and Negotiate ads bought at the target offer (90% of the comparable median, or the asking price when lower).
	measure 'Margin at Target Offer' =
			CALCULATE ( SUM ( mart_buy_list[margin_at_target_brl] ), mart_buy_list[buy_class] IN { "Buy now", "Negotiate" } )
		formatString: \R\$ #,0
		displayFolder: Buy list
		lineageTag: b6d1bb0e-d450-5d23-8da6-583250803577


	/// Median expected margin per car at the target offer, Buy now and Negotiate ads.
	measure 'Median Margin per Car' =
			CALCULATE ( MEDIAN ( mart_buy_list[margin_at_target_brl] ), mart_buy_list[buy_class] IN { "Buy now", "Negotiate" } )
		formatString: \R\$ #,0
		displayFolder: Buy list
		lineageTag: 5d13105e-c01a-5f9d-a6bc-72b87ccc52a9


	/// Total asking price of the Buy now ads.
	measure 'Asking Price of Buy Now Ads' =
			CALCULATE ( SUM ( mart_buy_list[price_brl] ), mart_buy_list[buy_class] = "Buy now" )
		formatString: \R\$ #,0
		displayFolder: Buy list
		lineageTag: 42c93b8a-27ef-59d2-9915-2253f35351d4


	/// One-sentence answer for the Buy list page: how many private-seller ads are worth buying and what they would earn.
	measure 'Headline Buy' =
			VAR N = [Buy Candidates]
			VAR Now = [Buy Now Ads] + 0
			VAR Neg = [Negotiate Ads] + 0
			RETURN
				IF (
					ISBLANK ( N ),
					"No private-seller ads at or below their market median are online in this selection.",
					FORMAT ( N, "#,0" ) & " ads from private sellers are online at or below the median of comparable ads. "
						& FORMAT ( Now, "#,0" ) & IF ( Now = 1, " is", " are" ) & " a buy at the asking price (R$ " & FORMAT ( [Margin at Asking Price] + 0, "#,0" )
						& " expected margin after 2% preparation); at a target offer of 90% of the median, " & FORMAT ( Now + Neg, "#,0" )
						& " ads would clear R$ " & FORMAT ( [Margin at Target Offer] + 0, "#,0" ) & " in all, a median of R$ "
						& FORMAT ( [Median Margin per Car] + 0, "#,0" ) & " per car."
				)
		isHidden
		displayFolder: Story
		lineageTag: 3a5dd470-89c0-56d6-94c1-b80627389931


