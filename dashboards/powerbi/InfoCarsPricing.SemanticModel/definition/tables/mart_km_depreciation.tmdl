table mart_km_depreciation
	lineageTag: 49c2c7c6-0587-51e5-923e-bcc4f4859856

	/// Asking price lost per 10,000 km for the same version and model year, weighted by ads. Negative: the price falls.
	measure 'Loss per 10k km' =
			DIVIDE ( SUMX ( mart_km_depreciation, mart_km_depreciation[loss_per_10k_km_brl] * mart_km_depreciation[ads] ), SUM ( mart_km_depreciation[ads] ) )
		formatString: \R\$ #,0
		displayFolder: Drivers
		lineageTag: 891db55b-70ab-59df-bb92-12a9dd690e89


	/// The same loss as a share of the median price.
	measure 'Loss per 10k km %' =
			DIVIDE ( SUMX ( mart_km_depreciation, mart_km_depreciation[loss_per_10k_km_pct] * mart_km_depreciation[ads] ), SUM ( mart_km_depreciation[ads] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Drivers
		lineageTag: 3058f245-66d4-56d0-a39b-dcd72ec2c8ef


	/// Clean ads in the version and model-year groups large enough for a price-on-km fit.
	measure 'Ads in Regression' =
			SUM ( mart_km_depreciation[ads] )
		formatString: #,0
		displayFolder: Drivers
		lineageTag: 4c255858-b560-52ff-a1df-35d115d82b7d


	/// Share of the price spread inside a version and year that kilometres explain (R squared, weighted by ads).
	measure 'Fit R2' =
			DIVIDE ( SUMX ( mart_km_depreciation, mart_km_depreciation[r2] * mart_km_depreciation[ads] ), SUM ( mart_km_depreciation[ads] ) )
		formatString: 0%
		displayFolder: Drivers
		lineageTag: f030000d-b00a-57e2-8e4f-a0bbbdabee2a


