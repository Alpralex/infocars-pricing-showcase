table dim_date
	dataCategory: Time

	column date_day
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: date_day

	column week_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		summarizeBy: none
		sourceColumn: week_start

	column month_start
		dataType: dateTime
		formatString: mmm yyyy
		summarizeBy: none
		sourceColumn: month_start

	column year_number
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year_number

	column month_number
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: month_number

	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month_number

	column weekday_name
		dataType: string
		summarizeBy: none
		sourceColumn: weekday_name

	column is_snapshot
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: is_snapshot

	partition dim_date = m
		mode: import
		source =
				let
					Source = Parquet.Document ( File.Contents ( DataFolder & "dim_date.parquet" ) )
				in
					Source
