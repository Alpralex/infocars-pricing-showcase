table mart_data_quality

	measure 'Ads in Step' = SUM ( mart_data_quality[ads] )
		formatString: #,0

	column step_order
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: step_order

	column step_key
		dataType: string
		summarizeBy: none
		sourceColumn: step_key

	column step
		dataType: string
		summarizeBy: none
		sourceColumn: step
		sortByColumn: step_order

	column ads
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: ads

	partition mart_data_quality = m
		mode: import
		source =
				let
					Source = Parquet.Document ( File.Contents ( DataFolder & "mart_data_quality.parquet" ) )
				in
					Source
