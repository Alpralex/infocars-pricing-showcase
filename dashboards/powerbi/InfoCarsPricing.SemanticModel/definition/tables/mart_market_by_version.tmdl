table mart_market_by_version

	column make
		dataType: string
		summarizeBy: none
		sourceColumn: make

	column model
		dataType: string
		summarizeBy: none
		sourceColumn: model

	column version
		dataType: string
		summarizeBy: none
		sourceColumn: version

	column version_key
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: version_key

	column model_year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: model_year

	column state
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: state

	column listings
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: listings

	column active_listings
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: active_listings

	column p25_price_brl
		dataType: double
		formatString: \R\$ #,0
		summarizeBy: none
		sourceColumn: p25_price_brl

	column median_price_brl
		dataType: double
		formatString: \R\$ #,0
		summarizeBy: none
		sourceColumn: median_price_brl

	column p75_price_brl
		dataType: double
		formatString: \R\$ #,0
		summarizeBy: none
		sourceColumn: p75_price_brl

	column median_days_to_sell
		dataType: double
		formatString: 0.0
		summarizeBy: none
		sourceColumn: median_days_to_sell

	partition mart_market_by_version = m
		mode: import
		source =
				let
					Source = Parquet.Document ( File.Contents ( DataFolder & "mart_market_by_version.parquet" ) )
				in
					Source
