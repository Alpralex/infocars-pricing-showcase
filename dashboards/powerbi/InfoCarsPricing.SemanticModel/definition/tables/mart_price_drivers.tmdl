table mart_price_drivers
	lineageTag: 1442612a-8be7-5137-82fc-426e7b53dcc3

	/// Computed from fct_listings for the level on the axis, so the state and model slicers apply.
	/// Median gap of the asking price to the comparable median, for one factor level.
	measure 'Median Gap at Level' =
			IF ( HASONEVALUE ( mart_price_drivers[level] ), [Median Gap at Level One], MAXX ( VALUES ( mart_price_drivers[level] ), [Median Gap at Level One] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Drivers
		lineageTag: 8c456e97-a814-59aa-81fc-1c2988d3c0d5


	/// Helper for one level: the same measure when the factor and level are fixed.
	measure 'Median Gap at Level One' =
			VAR f = SELECTEDVALUE ( mart_price_drivers[factor] )
			VAR l = SELECTEDVALUE ( mart_price_drivers[level] )
			RETURN
				SWITCH (
					f,
					"Mileage", CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[km_band] = l ),
					"Seller", CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[seller_label] = l ),
					"Gearbox", CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[gearbox_label] = l ),
					"Fuel", CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[fuel_label] = l ),
					"Colour", CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[colour] = l ),
					"Photos", CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[photos_band] = l )
				)
		formatString: +0.0%;-0.0%;0.0%
		isHidden
		displayFolder: Drivers
		lineageTag: 6ef1dbdf-c2d8-5507-8715-a129788c9f61


	/// Clean ads with a market at this factor level.
	measure 'Ads at Level' =
			IF ( HASONEVALUE ( mart_price_drivers[level] ), [Ads at Level One], SUMX ( VALUES ( mart_price_drivers[level] ), [Ads at Level One] ) )
		formatString: #,0
		displayFolder: Drivers
		lineageTag: bd54e004-64e3-5120-9a61-b82cf9bad950


	/// Helper for one level: the same measure when the factor and level are fixed.
	measure 'Ads at Level One' =
			VAR f = SELECTEDVALUE ( mart_price_drivers[factor] )
			VAR l = SELECTEDVALUE ( mart_price_drivers[level] )
			RETURN
				SWITCH (
					f,
					"Mileage", CALCULATE ( COUNTROWS ( fct_listings ), fct_listings[price_position] <> "too few comparables", fct_listings[km_band] = l ),
					"Seller", CALCULATE ( COUNTROWS ( fct_listings ), fct_listings[price_position] <> "too few comparables", fct_listings[seller_label] = l ),
					"Gearbox", CALCULATE ( COUNTROWS ( fct_listings ), fct_listings[price_position] <> "too few comparables", fct_listings[gearbox_label] = l ),
					"Fuel", CALCULATE ( COUNTROWS ( fct_listings ), fct_listings[price_position] <> "too few comparables", fct_listings[fuel_label] = l ),
					"Colour", CALCULATE ( COUNTROWS ( fct_listings ), fct_listings[price_position] <> "too few comparables", fct_listings[colour] = l ),
					"Photos", CALCULATE ( COUNTROWS ( fct_listings ), fct_listings[price_position] <> "too few comparables", fct_listings[photos_band] = l )
				)
		formatString: #,0
		isHidden
		displayFolder: Drivers
		lineageTag: 3e3f253d-4167-5751-8568-daa924bff8ee


	/// Share of the ads at this level priced above the 75th percentile of comparables.
	measure 'Above Market Share at Level' =
			VAR f = SELECTEDVALUE ( mart_price_drivers[factor] )
			VAR l = SELECTEDVALUE ( mart_price_drivers[level] )
			RETURN
				DIVIDE ( SWITCH (
						f,
						"Mileage", CALCULATE ( COUNTROWS ( fct_listings ), fct_listings[price_position] = "above market", fct_listings[km_band] = l ),
						"Seller", CALCULATE ( COUNTROWS ( fct_listings ), fct_listings[price_position] = "above market", fct_listings[seller_label] = l ),
						"Gearbox", CALCULATE ( COUNTROWS ( fct_listings ), fct_listings[price_position] = "above market", fct_listings[gearbox_label] = l ),
						"Fuel", CALCULATE ( COUNTROWS ( fct_listings ), fct_listings[price_position] = "above market", fct_listings[fuel_label] = l ),
						"Colour", CALCULATE ( COUNTROWS ( fct_listings ), fct_listings[price_position] = "above market", fct_listings[colour] = l ),
						"Photos", CALCULATE ( COUNTROWS ( fct_listings ), fct_listings[price_position] = "above market", fct_listings[photos_band] = l )
					), [Ads at Level] )
		formatString: 0%
		displayFolder: Drivers
		lineageTag: c514523e-0eb2-5d07-9f77-099b86f532bd


	/// Helper: the median gap for the factor and level in context, ignoring other filters on the table.
	measure 'Driver Gap' =
			VAR f = SELECTEDVALUE ( mart_price_drivers[factor] )
			VAR l = SELECTEDVALUE ( mart_price_drivers[level] )
			RETURN
				SWITCH (
					f,
					"Mileage", CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[km_band] = l ),
					"Seller", CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[seller_label] = l ),
					"Gearbox", CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[gearbox_label] = l ),
					"Fuel", CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[fuel_label] = l ),
					"Colour", CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[colour] = l ),
					"Photos", CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[photos_band] = l )
				)
		formatString: +0.0%;-0.0%;0.0%
		isHidden
		displayFolder: Drivers
		lineageTag: e48376b4-9cf7-5b3a-bd87-87fecf71a5b5


	/// One-sentence answer for the Price drivers page: what moves an ad's price against its market.
	measure 'Headline Drivers' =
			VAR Loss = [Loss per 10k km]
			VAR LossPct = [Loss per 10k km %]
			VAR Priv = CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[seller_label] = "Private seller" )
			VAR Deal = CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[seller_label] = "Dealer" )
			VAR Photos = CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ), fct_listings[photos_band] = "16 or more" )
			VAR Colour = MAXX ( VALUES ( fct_listings[colour] ), ABS ( CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ) ) ) )
			VAR Fuel = MAXX ( VALUES ( fct_listings[fuel_label] ), ABS ( CALCULATE ( MEDIAN ( fct_listings[gap_to_median_pct] ) ) ) )
			RETURN
				IF (
					ISBLANK ( Loss ),
					"No groups large enough for a fit in this selection.",
					"Same car, same year: each 10,000 km takes about R$ " & FORMAT ( -Loss, "#,0" ) & " (" & FORMAT ( -LossPct, "0.0%" )
						& ") off the asking price. Private sellers ask " & FORMAT ( -Priv, "0.0%" ) & " under the comparable median and dealers "
						& FORMAT ( Deal, "0.0%" ) & " over; ads with 16 or more photos sit " & FORMAT ( Photos, "0.0%" ) & " above. Colour and fuel move it by "
						& FORMAT ( MAX ( Colour, Fuel ), "0.0%" ) & " at most."
				)
		isHidden
		displayFolder: Story
		lineageTag: aa775fff-b472-583f-8896-56663263e186


