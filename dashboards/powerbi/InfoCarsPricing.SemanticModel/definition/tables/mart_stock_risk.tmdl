table mart_stock_risk
	lineageTag: 0043903f-a70f-50fe-9765-ac132e4ac2f1

	/// Ads still online with enough comparables to score.
	measure 'Ads Scored' =
			COUNTROWS ( mart_stock_risk )
		formatString: #,0
		displayFolder: Stock risk
		lineageTag: 59f48296-d56d-58cd-9824-b3331c213d24


	/// Ads online with a risk score of 60 or more: likely to get stuck.
	measure 'High Risk Ads' =
			CALCULATE ( COUNTROWS ( mart_stock_risk ), mart_stock_risk[risk_band] = "High" )
		formatString: #,0
		displayFolder: Stock risk
		lineageTag: 4e7ef032-8b7b-5caf-889d-9d49f60aa57e


	/// Ads online with a risk score from 35 to 59.
	measure 'Medium Risk Ads' =
			CALCULATE ( COUNTROWS ( mart_stock_risk ), mart_stock_risk[risk_band] = "Medium" )
		formatString: #,0
		displayFolder: Stock risk
		lineageTag: 86ab3604-fa06-5850-9f86-514676d30b21


	/// Total price cut that would bring the high-risk ads back to the 75th percentile of their comparables.
	measure 'High Risk Cut to Range' =
			CALCULATE ( SUM ( mart_stock_risk[cut_to_range_brl] ), mart_stock_risk[risk_band] = "High" )
		formatString: \R\$ #,0
		displayFolder: Stock risk
		lineageTag: 14492d52-79d6-5f24-b8a4-ee00413b116c


	/// Median days online of the high-risk ads.
	measure 'High Risk Median Days Online' =
			CALCULATE ( MEDIAN ( mart_stock_risk[days_on_market] ), mart_stock_risk[risk_band] = "High" )
		formatString: 0
		displayFolder: Stock risk
		lineageTag: 5356b327-70a1-548e-b0dc-74206ab7cb4d


	/// Median gap to the comparable median of the high-risk ads.
	measure 'High Risk Median Gap' =
			CALCULATE ( MEDIAN ( mart_stock_risk[gap_to_median_pct] ), mart_stock_risk[risk_band] = "High" )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Stock risk
		lineageTag: 9cb1f1d2-3a41-5c10-8d3f-3dd5d8e19ffc


	/// Average risk score of the ads in context (0 to 100).
	measure 'Average Risk Score' =
			AVERAGE ( mart_stock_risk[risk_score] )
		formatString: 0
		displayFolder: Stock risk
		lineageTag: 1accf0ca-aae3-5ada-a43d-0724df23b2da


