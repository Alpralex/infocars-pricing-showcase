table mart_price_changes
	lineageTag: a3ab2091-edbd-597c-b04c-1e91b857b386

	/// Ads that cut their asking price once while online.
	measure 'Ads That Cut the Price' =
			CALCULATE ( COUNTROWS ( mart_price_changes ), mart_price_changes[had_price_cut] = 1 )
		formatString: #,0
		displayFolder: Stock risk
		lineageTag: fb52811b-3db1-5b88-9b93-deace4c01f07


	/// Median size of the cut.
	measure 'Median Cut %' =
			CALCULATE ( MEDIAN ( mart_price_changes[price_cut_pct] ), mart_price_changes[had_price_cut] = 1 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Stock risk
		lineageTag: 843ad064-12fa-532e-a966-947ba16548c7


	/// Median days from the cut to the sale, for cut ads that sold.
	measure 'Median Days to Sell After Cut' =
			CALCULATE ( MEDIAN ( mart_price_changes[days_after_cut] ), mart_price_changes[had_price_cut] = 1, mart_price_changes[is_sold] = 1 )
		formatString: 0
		displayFolder: Stock risk
		lineageTag: 286afed5-ff5c-580b-9d0e-72ed88ce19fd


	/// Median days on the site for sold ads that never cut their price.
	measure 'Never Cut Median Days to Sell' =
			CALCULATE ( MEDIAN ( mart_price_changes[days_on_market] ), mart_price_changes[had_price_cut] = 0, mart_price_changes[is_sold] = 1 )
		formatString: 0
		displayFolder: Stock risk
		lineageTag: 43a0b56b-83a6-529a-ba9d-3e27e22f674c


	/// Share of the cuts that took an ad from above its market range to inside it.
	measure 'Cuts Into Range %' =
			DIVIDE ( CALCULATE ( SUM ( mart_price_changes[cut_brought_into_range] ) ), [Ads That Cut the Price] )
		formatString: 0%
		displayFolder: Stock risk
		lineageTag: f5e78e5f-2f64-58aa-b451-ec2af33869d3


	/// One-sentence answer for the Stock risk page: which ads are likely to get stuck, how fast the stock turns, and whether price cuts work.
	measure 'Headline Stock' =
			VAR N = [Ads Scored]
			VAR Hi = [High Risk Ads] + 0
			VAR S30 = [Still Online at 30 Days]
			VAR S90 = [Still Online at 90 Days]
			VAR Cut = [Ads That Cut the Price] + 0
			RETURN
				IF (
					ISBLANK ( N ),
					"No ads online with a market in this selection.",
					"Of " & FORMAT ( N, "#,0" ) & " ads online with a market, " & FORMAT ( Hi, "#,0" ) & IF ( Hi = 1, " is", " are" )
						& " at high risk of getting stuck (score 60 or more), a median of " & FORMAT ( [High Risk Median Days Online], "0" ) & " days online and "
						& FORMAT ( [High Risk Median Gap], "0%" ) & " over the market; R$ " & FORMAT ( [High Risk Cut to Range] + 0, "#,0" )
						& " of cuts would bring them back into range. "
						& IF ( NOT ISBLANK ( S30 ), FORMAT ( 1 - S30, "0%" ) & " of ads leave within 30 days, " & FORMAT ( S90, "0%" ) & " are still online after 90. ", "" )
						& IF ( Cut > 0, "The " & FORMAT ( Cut, "#,0" ) & " ads that cut their price sold a median of " & FORMAT ( [Median Days to Sell After Cut], "0" )
							& " days after the cut (" & FORMAT ( [Never Cut Median Days to Sell], "0" ) & " for ads that never cut).", "" )
				)
		isHidden
		displayFolder: Story
		lineageTag: b1e93857-fee6-5a69-a316-f5ffbf66a00b


