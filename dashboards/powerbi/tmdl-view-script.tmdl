			summarizeBy: sum
			sourceColumn: km

		column listed_date
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: listed_date

		column removed_date
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: removed_date

		column last_seen_date
			dataType: dateTime
			formatString: yyyy-mm-dd
			summarizeBy: none
			sourceColumn: last_seen_date

		column days_on_market
			dataType: int64
			formatString: 0
			summarizeBy: sum
			sourceColumn: days_on_market

		column is_active
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: is_active

		column is_sold
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: is_sold

		column comparables
			dataType: int64
			formatString: 0
			summarizeBy: none
			sourceColumn: comparables

		column market_p25_brl
			dataType: double
			formatString: \R\$ #,0
			summarizeBy: none
			sourceColumn: market_p25_brl

		column market_median_brl
			dataType: double
			formatString: \R\$ #,0
			summarizeBy: none
			sourceColumn: market_median_brl

		column market_p75_brl
			dataType: double
			formatString: \R\$ #,0
			summarizeBy: none
			sourceColumn: market_p75_brl

		column gap_to_median_brl
			dataType: double
			formatString: \R\$ #,0
			summarizeBy: sum
			sourceColumn: gap_to_median_brl

		column gap_to_median_pct
			dataType: double
			formatString: +0.0%;-0.0%;0.0%
			summarizeBy: none
			sourceColumn: gap_to_median_pct

		column price_position
			dataType: string
			summarizeBy: none
